# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Cloudflare Worker / Jest test harness
node_modules/
.wrangler/
coverage/

# Local/generated run artifacts
.codex-*.log
flutter_*.log
flutter_*.png

# Historical local backups should stay out of active source control.
android_backup/
android_old/

# Local debug data exports
__*.json
temp_error.json

# Firebase service account keys must never be committed
service-account.json

# Local RTDB backup dumps (may contain PII) - never commit
backups/

# Per-tenant provisioning output (generated worker configs + secret values) —
# never commit; see tool/provision_instance.mjs and docs/PROVISIONING.md
deploy/tenants/
*.env.tenant

# Generated quote PDFs/sidecars (customer data) — see tool/generate_quote.mjs
quotes/

# On-disk gateway retry queue (see gateway/)
gateway/queue/

# Android signing material + built APKs — never commit.
*.apk
*.keystore
*.jks
android/key.properties
android/**/keystore.properties
# The committed android/app/google-services.json is the shared DEMO default the
# base build needs. Per-tenant google-services.json is injected at build time by
# .github/workflows/build-tenant-apk.yml (from an environment secret) and must
# NEVER be committed. Ignoring the path blocks an accidental tenant commit
# without untracking the already-tracked demo default.
android/app/google-services.json
dist/*.apk
