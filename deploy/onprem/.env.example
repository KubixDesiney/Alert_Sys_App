# SIAS on-prem configuration template. Copy to .env and fill in.
# NO real secrets in this file — install.sh / install.ps1 generate them.
# Keep .env chmod 600; use scripts/encrypt-env.sh for at-rest encryption.

# ── Host / basics ─────────────────────────────────────────────────────────
SIA_HOST=sia.local
TZ=UTC
# Pinned release tag for locally-built images (update.sh bumps this).
SIAS_TAG=1.2.1
# Opaque installation identity used ONLY by licensing (never operational data).
INSTALLATION_ID=

# ── Secrets (generated by the installer — never commit) ──────────────────
# Deployment-wide service secret: worker-runner SSE + gateway->runner ingest.
WORKER_SHARED_SECRET=
# PocketBase superuser token for the worker-runner (create in PB admin UI).
PB_TOKEN=
# First PocketBase admin (bootstrap only; rotate after first login).
PB_ADMIN_EMAIL=admin@sia.local
PB_ADMIN_PASSWORD=

# ── Worker-runner tuning ──────────────────────────────────────────────────
CRON_INTERVAL_MS=60000
RETENTION_DAYS=365
BACKUP_KEEP=14
# Named integration keys for direct /ingest calls: "name1:key1,name2:key2"
INGEST_KEYS=

# ── Edge gateway ──────────────────────────────────────────────────────────
# Extra HTTP adapter API keys (merged with gateway.config.json apiKeys).
GATEWAY_API_KEYS=

# ── Licensing (privacy-preserving; see deploy/onprem/license/) ───────────
# Air-gapped: drop the vendor-issued token into secrets/license.sias and leave
# LICENSE_SERVER_URL empty. Connected: set the URL; 7 or 14 day offline grace.
LICENSE_SERVER_URL=
LICENSE_GRACE_DAYS=7
