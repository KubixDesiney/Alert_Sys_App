{
  "rules": {

    "alerts": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": [
        "usine", "status", "superviseurId", "assistantId",
        "type", "convoyeur", "poste", "assetId", "alertNumber",
        "push_sent", "isEscalated"
      ],
      "$alertId": {
        ".read": "auth != null",
        ".write": "auth != null || (auth == null && !data.exists() && newData.hasChildren(['adresse','convoyeur','poste','timestamp','type','usine']) && newData.child('adresse').isString() && newData.child('convoyeur').isNumber() && newData.child('poste').isNumber() && newData.child('timestamp').isString() && newData.child('type').isString() && newData.child('usine').isString())",
        "adresse": { ".validate": "newData.isString()" },
        "convoyeur": { ".validate": "newData.isNumber()" },
        "poste": { ".validate": "newData.isNumber()" },
        "assetId": { ".validate": "!newData.exists() || newData.isString()" },
        "timestamp": { ".validate": "newData.isString()" },
        "type": { ".validate": "newData.isString()" },
        "usine": { ".validate": "newData.isString()" },
        "description": { ".validate": "!newData.exists() || newData.isString()" },
        "status": { ".validate": "!newData.exists() || newData.isString()" },
        "push_sent": { ".validate": "!newData.exists() || newData.isBoolean()" },
        "push_sending": { ".validate": "!newData.exists() || newData.isBoolean()" },
        "push_sending_at": { ".validate": "!newData.exists() || newData.isString()" },
        "push_sent_at": { ".validate": "!newData.exists() || newData.isString()" },
        "push_last_error_at": { ".validate": "!newData.exists() || newData.isString()" },
        "push_skip_reason": { ".validate": "!newData.exists() || newData.isString()" },
        "notificationSent": { ".validate": "!newData.exists() || newData.isBoolean()" },
        "isCritical": { ".validate": "!newData.exists() || newData.isBoolean()" },
        "aiHistory": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },

    "supervisor_active_alerts": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$supervisorId": {
        ".read": "auth != null && (auth.uid === $supervisorId || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (auth.uid === $supervisorId || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },

    "collaboration_alerts": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$supervisorId": {
        ".read": "auth != null && (auth.uid === $supervisorId || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },

    "notifications": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$userId": {
        ".read": "auth != null && (auth.uid === $userId || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "$notifId": {
          ".read": "auth != null && (auth.uid === $userId || root.child('users').child(auth.uid).child('role').val() === 'admin')",
          ".write": "auth != null && ((auth.uid === $userId) || root.child('users').child(auth.uid).child('role').val() === 'admin' || (root.child('users').child(auth.uid).child('role').val() === 'supervisor' && !data.exists()))"
        }
      }
    },

    "pm_actions": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$userId": {
        ".read": "auth != null && (auth.uid === $userId || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (auth.uid === $userId || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },

    "alertCounter": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "assetCounter": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.role === 'admin')"
    },

    "assets": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.role === 'admin')",
      "$assetId": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.role === 'admin')",
        "assetId": { ".validate": "!newData.exists() || newData.isString()" },
        "name": { ".validate": "!newData.exists() || newData.isString()" },
        "factoryId": { ".validate": "!newData.exists() || newData.isString()" },
        "factoryName": { ".validate": "!newData.exists() || newData.isString()" },
        "conveyorId": { ".validate": "!newData.exists() || newData.isString()" },
        "conveyorNumber": { ".validate": "!newData.exists() || newData.isNumber()" },
        "stationId": { ".validate": "!newData.exists() || newData.isString()" },
        "stationNumber": { ".validate": "!newData.exists() || newData.isNumber()" },
        "address": { ".validate": "!newData.exists() || newData.isString()" },
        "updatedAt": { ".validate": "!newData.exists() || newData.isString()" },
        "history": {
          "$index": {
            ".validate": "newData.hasChildren(['movedAt', 'from', 'to'])"
          }
        }
      }
    },

    "users": {
      ".read": "auth != null",
      ".write": false,
      ".indexOn": ["role", "usine", "aiOptOut"],
      "$userId": {
        ".read": "auth.uid === $userId || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'SuperAdmin' || auth.token.role === 'admin'",
        ".write": "auth != null && (auth.uid === $userId || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'SuperAdmin' || auth.token.role === 'admin')",
        "currentLocation": {
          ".validate": "newData.hasChildren(['lat','lng']) && newData.child('lat').isNumber() && newData.child('lng').isNumber() && (!newData.child('updatedAt').exists() || newData.child('updatedAt').isNumber() || newData.child('updatedAt').isString())"
        }
      }
    },

    "users_private": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'SuperAdmin' || auth.token.role === 'admin')",
      "$userId": {
        ".read": "auth != null && (auth.uid === $userId || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'SuperAdmin' || auth.token.role === 'admin')",
        ".write": "auth != null && (auth.uid === $userId || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'SuperAdmin' || auth.token.role === 'admin')",
        "email": { ".validate": "!newData.exists() || newData.isString()" },
        "phone": { ".validate": "!newData.exists() || newData.isString()" },
        "fcmToken": { ".validate": "!newData.exists() || newData.isString()" },
        "currentLocation": {
          ".validate": "newData.hasChildren(['lat','lng']) && newData.child('lat').isNumber() && newData.child('lng').isNumber() && (!newData.child('updatedAt').exists() || newData.child('updatedAt').isNumber() || newData.child('updatedAt').isString())"
        }
      }
    },

    "hierarchy": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.role === 'admin')",
      ".indexOn": ["name"]
    },

    "collaboration_requests": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'supervisor' || auth.token.role === 'admin')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'supervisor' || auth.token.role === 'admin')",
      ".indexOn": ["requesterId", "status", "pmApproved", "timestamp", "alertId"]
    },

    "help_requests": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'supervisor' || auth.token.role === 'admin')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'supervisor' || auth.token.role === 'admin')",
      ".indexOn": ["alertId", "requesterId", "targetSupervisorId", "status", "timestamp"]
    },

    "escalation_settings": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.role === 'admin')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.role === 'admin')"
    },

    "supervisors": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.role === 'admin')",
      ".indexOn": ["usine", "active"]
    },

    "ai_decisions": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'supervisor' || auth.token.role === 'admin')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.role === 'admin')",
      ".indexOn": ["timestamp", "alertId"]
    },

    "ai_feedback": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.role === 'admin')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.role === 'admin')"
    },

    "ai_master": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.role === 'admin')"
    },

    "ai_predictions": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.role === 'admin')"
    },

    "ai_briefing": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.role === 'admin')"
    },

    "shifts": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.role === 'admin')",
      ".indexOn": ["startMinutes", "aiCommander"],
      "$shiftId": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.role === 'admin')",
        "name": { ".validate": "newData.isString()" },
        "startMinutes": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1439" },
        "endMinutes": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1439" },
        "maxSupervisors": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 1 && newData.val() <= 50)" },
        "aiCommander": { ".validate": "!newData.exists() || newData.isBoolean()" },
        "randomize": { ".validate": "!newData.exists() || newData.isBoolean()" },
        "aiConfidence": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 1)" },
        "handleAssignments": { ".validate": "!newData.exists() || newData.isBoolean()" },
        "handleCollaborations": { ".validate": "!newData.exists() || newData.isBoolean()" },
        "handleCrossFactoryTransfer": { ".validate": "!newData.exists() || newData.isBoolean()" },
        "fullControl": { ".validate": "!newData.exists() || newData.isBoolean()" },
        "crossFactoryMaxDistanceKm": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 20000)" },
        "supervisors": {
          "$supervisorId": {
            "ready": {
              ".write": "auth != null && (auth.uid === $supervisorId || root.child('users').child(auth.uid).child('role').val() === 'admin')",
              ".validate": "newData.isBoolean()"
            }
          }
        }
      }
    },

    "shift_ai_logs": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'supervisor' || auth.token.role === 'admin')",
      "$shiftId": {
        ".read": "auth != null",
        "$logId": {
          ".read": "auth != null",
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.role === 'admin')",
          "at": { ".validate": "!newData.exists() || newData.isString()" },
          "kind": { ".validate": "!newData.exists() || newData.isString()" },
          "shiftId": { ".validate": "!newData.exists() || newData.isString()" },
          "alertLabel": { ".validate": "!newData.exists() || newData.isString()" },
          "supervisorName": { ".validate": "!newData.exists() || newData.isString()" },
          "supervisorId": { ".validate": "!newData.exists() || newData.isString()" },
          "factory": { ".validate": "!newData.exists() || newData.isString()" },
          "confidence": { ".validate": "!newData.exists() || newData.isNumber()" },
          "reason": { ".validate": "!newData.exists() || newData.isString()" },
          "details": { ".validate": "!newData.exists() || newData.isString()" }
        }
      }
    },

    "shift_presence": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$shiftId": {
        ".read": "auth != null",
        "$supervisorId": {
          ".read": "auth != null",
          ".write": "auth != null && (auth.uid === $supervisorId || root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.role === 'admin')",
          "name": { ".validate": "!newData.exists() || newData.isString()" },
          "factory": { ".validate": "!newData.exists() || newData.isString()" },
          "status": { ".validate": "!newData.exists() || newData.isString()" },
          "lastActiveAt": { ".validate": "!newData.exists() || newData.isString()" },
          "inactiveSince": { ".validate": "!newData.exists() || newData.isString()" },
          "confirmRequestedAt": { ".validate": "!newData.exists() || newData.isString()" },
          "confirmExpiresAt": { ".validate": "!newData.exists() || newData.isString()" },
          "confirmedAt": { ".validate": "!newData.exists() || newData.isString()" },
          "joinedAt": { ".validate": "!newData.exists() || newData.isString()" },
          "statusDurationSeconds": { ".validate": "!newData.exists() || newData.isNumber()" }
        }
      }
    },

    "security": {
      ".read": "auth != null && (auth.token.role === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'SuperAdmin')",
      ".write": "auth != null && auth.token.role === 'admin'",
      "logs": {
        ".read": "auth != null && (auth.token.role === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'SuperAdmin')",
        ".write": "auth != null && auth.token.role === 'admin'",
        ".indexOn": ["at", "kind", "fingerprint"]
      },
      "actions": {
        ".read": "auth != null && (auth.token.role === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'SuperAdmin')",
        ".write": "auth != null && auth.token.role === 'admin'",
        ".indexOn": ["at", "kind", "endpoint", "fingerprint"]
      },
      "siem_outbox": {
        ".read": "auth != null && auth.token.role === 'admin'",
        ".write": "auth != null && auth.token.role === 'admin'",
        ".indexOn": ["status", "nextAttemptAt", "exportedAt"]
      },
      "siem_export_status": {
        ".read": "auth != null && auth.token.role === 'admin'",
        ".write": "auth != null && auth.token.role === 'admin'"
      }
    },

    "workers": {
      ".read": "auth != null && (auth.token.role === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'SuperAdmin')",
      ".write": "auth != null && auth.token.role === 'admin'",
      "health": {
        ".read": "auth != null && (auth.token.role === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'SuperAdmin')",
        ".write": "auth != null && auth.token.role === 'admin'"
      }
    },

    "ai_agents": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'SuperAdmin' || auth.token.role === 'admin')",
      "$agentId": {
        "enabled": { ".validate": "newData.isBoolean()" },
        "updatedAt": { ".validate": "!newData.exists() || newData.isString()" },
        "promptTemplate": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 8000)" },
        "promptUpdatedAt": { ".validate": "!newData.exists() || newData.isString()" },
        "settings": {
          "weights": {
            "$category": {
              "$factor": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
              }
            }
          }
        },
        "logs": {
          ".indexOn": ["at"]
        }
      }
    },

    "ai_agent_secrets": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'SuperAdmin')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'SuperAdmin')",
      "$agentId": {
        "apiToken": { ".validate": "newData.isString() && newData.val().length <= 4000" },
        "updatedAt": { ".validate": "!newData.exists() || newData.isString()" }
      }
    },

    "ai_forecast": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'SuperAdmin' || root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.role === 'admin')",
      "model": {
        "weights": { ".validate": "newData.isString()" },
        "algo": { ".validate": "!newData.exists() || newData.isString()" },
        "featureCount": { ".validate": "!newData.exists() || newData.isNumber()" },
        "rounds": { ".validate": "!newData.exists() || newData.isNumber()" },
        "adaptedRounds": { ".validate": "!newData.exists() || newData.isNumber()" },
        "trainedAt": { ".validate": "newData.isString()" },
        "lastAdaptedAt": { ".validate": "!newData.exists() || newData.isString()" },
        "version": { ".validate": "!newData.exists() || newData.isNumber()" },
        "datasetName": { ".validate": "!newData.exists() || newData.isString()" },
        "sampleCount": { ".validate": "!newData.exists() || newData.isNumber()" },
        "valLoss": { ".validate": "!newData.exists() || newData.isNumber()" },
        "valAccuracy": { ".validate": "!newData.exists() || newData.isNumber()" },
        "learning": { ".validate": "!newData.exists() || newData.isBoolean()" }
      }
    },

    "bugs": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'SuperAdmin' || auth.token.role === 'admin')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'SuperAdmin' || auth.token.role === 'admin')",
      "client": {
        ".indexOn": ["lastSeenAt", "status", "area"],
        "$bugId": {
          ".write": "auth != null"
        }
      },
      "agent": {
        ".indexOn": ["at", "status"]
      }
    },

    "cron_lock": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.role === 'admin')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.role === 'admin')"
    },

    "factories": {
      ".read": "auth != null",
      "$factoryId": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.role === 'admin')",
        "name": { ".validate": "!newData.exists() || newData.isString()" },
        "address": { ".validate": "!newData.exists() || newData.isString()" },
        "location": {
          ".validate": "newData.hasChildren(['lat','lng']) && newData.child('lat').isNumber() && newData.child('lng').isNumber()"
        },
        "aiConfig": {
          ".read": "auth != null",
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.role === 'admin')",
          "enabled": { ".validate": "newData.isBoolean()" },
          "skippedAlertTtlMinutes": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 1 && newData.val() <= 240)" }
        }
      }
    },

    "audit_log": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'SuperAdmin' || auth.token.role === 'admin')",
      ".indexOn": ["at", "actorId", "action", "targetType", "targetId", "factoryId"],
      "$entryId": {
        ".write": "auth != null && !data.exists() && newData.hasChildren(['at','actorId','action']) && (newData.child('actorId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.role === 'admin')",
        "at": { ".validate": "newData.isString()" },
        "actorId": { ".validate": "newData.isString()" },
        "actorName": { ".validate": "!newData.exists() || newData.isString()" },
        "actorRole": { ".validate": "!newData.exists() || newData.isString()" },
        "action": { ".validate": "newData.isString()" },
        "targetType": { ".validate": "!newData.exists() || newData.isString()" },
        "targetId": { ".validate": "!newData.exists() || newData.isString()" },
        "factoryId": { ".validate": "!newData.exists() || newData.isString()" },
        "detail": { ".validate": "!newData.exists() || newData.isString()" },
        "metadata": { ".validate": "!newData.exists() || newData.isString()" },
        "$other": { ".validate": false }
      }
    },

    "auth_config": {
      ".read": true,
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'SuperAdmin')",
      "mfaRequired": { ".validate": "!newData.exists() || newData.isBoolean()" },
      "sso": {
        "enabled": { ".validate": "!newData.exists() || newData.isBoolean()" },
        "type": { ".validate": "!newData.exists() || newData.isString()" },
        "providerId": { ".validate": "!newData.exists() || newData.isString()" },
        "label": { ".validate": "!newData.exists() || newData.isString()" },
        "issuer": { ".validate": "!newData.exists() || newData.isString()" },
        "template": { ".validate": "!newData.exists() || newData.isString()" },
        "updatedAt": { ".validate": "!newData.exists() || newData.isString()" }
      }
    },

    "monitoring_config": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'SuperAdmin')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'SuperAdmin')"
    },

    "infra_config": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'SuperAdmin')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'SuperAdmin')"
    },

    "ai_model_config": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'SuperAdmin')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'SuperAdmin')",
      "$agent": {
        "modelId": { ".validate": "newData.isString()" },
        "apiKey": { ".validate": "!newData.exists() || newData.isString()" },
        "provider": { ".validate": "!newData.exists() || newData.isString()" },
        "updatedAt": { ".validate": "!newData.exists() || newData.isString()" },
        "$other": { ".validate": false }
      }
    },

    "telemetry": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'SuperAdmin')",
      ".indexOn": ["lastAt"],
      "daily": {
        "$date": {
          ".write": "auth != null",
          "sessions": { ".validate": "newData.isNumber()" },
          "errorSessions": { ".validate": "newData.isNumber()" },
          "errors": { ".validate": "newData.isNumber()" },
          "lastAt": { ".validate": "newData.isString()" },
          "$other": { ".validate": false }
        }
      }
    },

    "branding_config": {
      ".read": true,
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'SuperAdmin')",
      "primaryColor": { ".validate": "!newData.exists() || newData.isString()" },
      "accentColor": { ".validate": "!newData.exists() || newData.isString()" },
      "logoUrl": { ".validate": "!newData.exists() || newData.isString()" },
      "logoBackgroundless": { ".validate": "!newData.exists() || newData.isBoolean()" },
      "defaultDark": { ".validate": "!newData.exists() || newData.isBoolean()" },
      "updatedAt": { ".validate": "!newData.exists() || newData.isString()" }
    },

    "scim": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'SuperAdmin')",
      ".write": false
    },
    "provisioning": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'SuperAdmin')",
      ".write": false,
      "$key": {
        ".read": "auth != null && (!data.exists() || data.child('email').val() === auth.token.email || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'SuperAdmin')"
      }
    },

    ".read": false,
    ".write": false
  }
}
