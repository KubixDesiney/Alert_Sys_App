{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SIAS",
  "version": "1.2.1",
  "identifier": "com.kubixdesiney.sias",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "capabilities": ["default"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://*.kubixdesiney.com; form-action 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "KubixDesiney",
    "category": "Business",
    "copyright": "Copyright (c) 2026 KubixDesiney. All rights reserved.",
    "licenseFile": "../../LICENSE.md",
    "shortDescription": "SIAS - Smart Industrial Alert System",
    "longDescription": "Desktop client for SIAS - Smart Industrial Alert System: real-time industrial alerting, AI-assisted supervisor assignment, predictive maintenance forecasting, and shift coordination.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["English", "French"]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
