# Normalize all text files to LF in the repo; check out native on each OS.
* text=auto eol=lf

# Scripts that MUST stay LF (executed on Linux/edge)
*.sh   text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf

# Windows-only scripts stay CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Explicit text types
*.dart text
*.js   text
*.ts   text
*.json text
*.yaml text
*.yml  text
*.md   text
*.toml text
*.kt   text
*.kts  text
*.gradle text
*.xml  text
*.html text
*.css  text
*.svg  text
*.lock text

# Binary assets (never diff or normalize)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.tflite binary
*.onnx binary
*.so   binary
*.jar  binary
*.keystore binary
*.jks  binary
*.zip  binary
*.pdf  binary
*.mp3  binary
*.wav  binary
