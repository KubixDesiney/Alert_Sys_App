{
  "name": "alertsys-worker",
  "version": "1.1.0",
  "private": true,
  "description": "Smart Industrial Alert - SIA Cloudflare Worker â€” AI scoring, escalation cron, push fan-out.",
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:rules": "node --experimental-vm-modules node_modules/jest/bin/jest.js worker_test/database_rules_security.test.js worker_test/firebase_rules_configuration.test.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "agent:bugfix": "node tool/autonomous_bugfix_agent.mjs",
    "agent:bugfix:dry-run": "node tool/autonomous_bugfix_agent.mjs --dry-run",
    "deploy": "npm run deploy:workers",
    "deploy:ai": "wrangler deploy --config wrangler.ai.toml",
    "deploy:notify": "wrangler deploy --config wrangler.notify.toml",
    "deploy:workers": "npm run deploy:ai && npm run deploy:notify",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "bench": "node tool/load_benchmark.mjs",
    "bench:ci": "node tool/load_benchmark.mjs --sups=1000 --alerts=50000 --decisions=2000 --max-p99=5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "wrangler": "^4.100.0"
  },
  "dependencies": {
    "firebase-admin": "^14.0.0"
  }
}
