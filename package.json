{
  "name": "alertsys-worker",
  "version": "1.1.0",
  "private": true,
  "description": "SIAS - Smart Industrial Alert System Cloudflare Worker — AI scoring, escalation cron, push fan-out.",
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.js",
    "test:rules": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.js worker_test/database_rules_security.test.js worker_test/firebase_rules_configuration.test.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.js --watch",
    "agent:bugfix": "node tool/autonomous_bugfix_agent.mjs",
    "agent:bugfix:dry-run": "node tool/autonomous_bugfix_agent.mjs --dry-run",
    "deploy": "npm run deploy:workers",
    "deploy:ai": "wrangler deploy --config wrangler.ai.toml",
    "deploy:notify": "wrangler deploy --config wrangler.notify.toml",
    "deploy:github": "wrangler deploy --config wrangler.github.toml",
    "deploy:ingest": "wrangler deploy --config wrangler.ingest.toml",
    "deploy:scim": "wrangler deploy --config wrangler.scim.toml",
    "deploy:monitor": "wrangler deploy --config wrangler.monitor.toml",
    "deploy:backup": "wrangler deploy --config wrangler.backup.toml",
    "deploy:store": "wrangler deploy --config wrangler.store.toml",
    "deploy:workers": "npm run deploy:ai && npm run deploy:notify && npm run deploy:github && npm run deploy:ingest && npm run deploy:scim && npm run deploy:monitor && npm run deploy:backup && npm run deploy:store",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.js --coverage",
    "test:mutation": "node tool/mutation_test.mjs --target tool/guardian_preflight.mjs --cmd \"npm test -- worker_test/guardian_preflight.test.js\" --floor 55 && node tool/mutation_test.mjs --target tool/guardian_providers.mjs --cmd \"npm test -- worker_test/guardian_providers.test.js\" --floor 40 && node tool/mutation_test.mjs --target worker/scoring.js --cmd \"npm test -- worker_test/scoring.test.js worker_test/score_supervisor.test.js\" --floor 35",
    "bench": "node tool/load_benchmark.mjs",
    "bench:ci": "node tool/load_benchmark.mjs --sups=1000 --alerts=50000 --decisions=2000 --max-p99=5",
    "provision:owner": "node tool/provision_owner.mjs",
    "provision:seats": "node tool/provision_seats.mjs",
    "provision:seed": "node tool/seed_tenant.mjs",
    "provision:instance": "node tool/provision_instance.mjs",
    "provision:paid-order": "node tool/provision_paid_order.mjs",
    "quote": "node tool/generate_quote.mjs",
    "legal:lint": "node tool/legal_lint.mjs",
    "legal:embed": "node tool/legal_embed.mjs",
    "verify:instance": "node tool/verify_instance.mjs",
    "teardown:instance": "node tool/teardown_instance.mjs",
    "tenants": "node tool/list_tenants.mjs",
    "backup:drill": "node tool/backup_drill.mjs"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "pdfkit": "^0.19.1",
    "wrangler": "^4.100.0"
  },
  "dependencies": {
    "firebase-admin": "^14.2.0"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "uuid": "11.1.1",
    "websocket-driver": "^0.7.5"
  }
}
